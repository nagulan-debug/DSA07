import numpy as np
from scipy import stats

drug = [10,12,11,13,14,12,15]
placebo = [5,6,7,8,6,5,7]

for data in [drug, placebo]:
    mean = np.mean(data)
    sem = stats.sem(data)
    ci = stats.t.interval(0.95, len(data)-1,
                          loc=mean, scale=sem)
    print("Mean:", mean)
    print("Confidence Interval:", ci)
