import pandas as pd

property_data = pd.DataFrame({
    'ID': [1, 2, 3, 4],
    'Location': ['Chennai', 'Madurai', 'Chennai', 'Trichy'],
    'Bedrooms': [3, 5, 4, 6],
    'Area': [1200, 1800, 1500, 2000],
    'Price': [200000, 300000, 250000, 400000]
})

# 1. Average price in each location
print(property_data.groupby('Location')['Price'].mean())

# 2. Properties with more than 4 bedrooms
print((property_data['Bedrooms'] > 4).sum())

# 3. Property with largest area
print(property_data.loc[property_data['Area'].idxmax()])
