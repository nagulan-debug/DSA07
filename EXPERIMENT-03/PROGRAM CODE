import numpy as np

house_data = np.array([
    [3, 1200, 200000],
    [5, 1800, 300000],
    [4, 1500, 250000],
    [6, 2000, 400000],
    [5, 1700, 350000]
])

# Select houses with more than 4 bedrooms
selected = house_data[house_data[:, 0] > 4]

# Calculate average sale price
avg = np.mean(selected[:, 2])

print("Average sale price:", avg)
