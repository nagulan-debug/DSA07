import pandas as pd

order_data = pd.DataFrame({
    'Customer_ID': [1, 2, 1, 3],
    'Order_Date': ['2026-01-02', '2026-01-03', '2026-01-05', '2026-01-06'],
    'Product': ['Pen', 'Book', 'Pen', 'Bag'],
    'Quantity': [2, 3, 4, 1]
})

# 1. Total orders by each customer
print(order_data.groupby('Customer_ID').size())

# 2. Average quantity of each product
print(order_data.groupby('Product')['Quantity'].mean())

# 3. Earliest and latest dates
print(order_data['Order_Date'].min())
print(order_data['Order_Date'].max())
