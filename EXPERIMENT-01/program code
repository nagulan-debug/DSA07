import numpy as np

# Student marks (4 students, 4 subjects)
student_scores = np.array([
    [80, 75, 85, 70],
    [90, 85, 80, 75],
    [70, 80, 90, 85],
    [85, 90, 75, 80]
])

# Calculate average of each subject
avg = np.mean(student_scores, axis=0)

print("Average scores:", avg)

# Find highest average
subjects = ["Math", "Science", "English", "History"]
highest = np.argmax(avg)

print("Highest average subject:", subjects[highest])
print("Highest average score:", avg[highest])
